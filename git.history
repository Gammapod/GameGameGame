diff --git a/src/GameGameGame.SadConsole.Browser/Pages/Index.razor.cs b/src/GameGameGame.SadConsole.Browser/Pages/Index.razor.cs
new file mode 100644
index 0000000..b3b673f
--- /dev/null
+++ b/src/GameGameGame.SadConsole.Browser/Pages/Index.razor.cs
@@ -0,0 +1,67 @@
+using System.Reflection;
+using GameGameGame.Content;
+using GameGameGame.SadConsoleApp;
+using Microsoft.JSInterop;
+using SadConsole;
+using SadConsole.Configuration;
+
+namespace GameGameGame.SadConsoleBrowser.Pages;
+
+public partial class Index
+{
+    private bool _created;
+
+    protected override void OnAfterRender(bool firstRender)
+    {
+        base.OnAfterRender(firstRender);
+
+        if (firstRender)
+        {
+            JsRuntime.InvokeAsync<object>("initRenderJS", DotNetObjectReference.Create(this));
+        }
+    }
+
+    [JSInvokable]
+    public void TickDotNet()
+    {
+        if (!_created)
+        {
+            CreateSadConsoleGame();
+            _created = true;
+        }
+
+        Game.Instance.Tick();
+    }
+
+    private static void CreateSadConsoleGame()
+    {
+        Settings.WindowTitle = "GameGameGame SadConsole Browser Spike";
+
+        var startup = CreateEmbeddedBetaStartup();
+        var contentAssembly = typeof(AlphaScenarioContent).Assembly;
+        var configuration = Builder.GetBuilder()
+            .ConfigureFonts((fonts, _) => fonts.UseBuiltinFontExtended())
+            .SetWindowSizeInCells(SadConsoleShell.ScreenWidth, SadConsoleShell.ScreenHeight)
+            .SetStartingScreen(_ => new SadConsoleShell(startup, contentAssembly))
+            .IsStartingScreenFocused(true);
+
+        Game.Create(configuration);
+        Game.Instance.Run();
+    }
+
+    private static SadConsoleStartup CreateEmbeddedBetaStartup()
+    {
+        var contentAssembly = typeof(AlphaScenarioContent).Assembly;
+        var catalog = ScenarioCatalog.DiscoverEmbeddedCatalog(contentAssembly);
+
+        if (catalog.Entries.Count == 0)
+        {
+            // Fallback to alpha if no beta scenarios are found
+            var document = AlphaScenarioContent.LoadDocument();
+            var session = PlayableScenarioLauncher.CreateFromDocument(document, AlphaScenarioContent.DefaultScenarioId);
+            return new SadConsoleStartup(session, null, "No Beta scenarios found in embedded resources. Loaded Alpha fallback.");
+        }
+
+        return new SadConsoleStartup(null, catalog, null);
+    }
+}
diff --git a/src/GameGameGame.SadConsole.Browser/Program.cs b/src/GameGameGame.SadConsole.Browser/Program.cs
