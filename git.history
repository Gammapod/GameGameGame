+<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
+
+  <PropertyGroup>
+    <TargetFramework>net8.0</TargetFramework>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <Nullable>enable</Nullable>
+    <RootNamespace>GameGameGame.SadConsoleBrowser</RootNamespace>
+    <AssemblyName>GameGameGame.SadConsole.Browser</AssemblyName>
+    <DefineConstants>$(DefineConstants);BLAZORGL;KNI</DefineConstants>
+    <KniPlatform>BlazorGL</KniPlatform>
+    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
+    <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
+    <PublishTrimmed>false</PublishTrimmed>
+    <!-- itch.io static hosting: disable Brotli/gzip compression so the Blazor loader
+         doesn't try to decompress .br/.gz files that itch.io's CDN serves without
+         Content-Encoding headers. Increases artifact size but avoids 404/decompression
+         failures on itch.io. -->
+    <BlazorEnableCompression>false</BlazorEnableCompression>
+    <!-- Spike-only: this must point at a SadConsole source checkout patched to build SadConsole.Host.MonoGame with KNI/BlazorGL instead of MonoGame.DesktopGL. -->
+    <SadConsoleSourceRoot Condition="'$(SadConsoleSourceRoot)' == ''">C:\Users\Scramble\AppData\Local\Temp\opencode\SadConsole-src</SadConsoleSourceRoot>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <ProjectReference Include="..\GameGameGame.Core\GameGameGame.Core.csproj" />
+    <ProjectReference Include="..\GameGameGame.Content\GameGameGame.Content.csproj" />
+    <ProjectReference Include="$(SadConsoleSourceRoot)\SadConsole.Host.MonoGame\SadConsole.Host.MonoGame.csproj" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <Compile Include="..\GameGameGame.SadConsole\SadConsoleStartup.cs" Link="SharedSadConsole\SadConsoleStartup.cs" />
+    <Compile Include="..\GameGameGame.SadConsole\SadConsoleShell.cs" Link="SharedSadConsole\SadConsoleShell.cs" />
+    <Compile Include="..\GameGameGame.SadConsole\SadConsoleViewModels.cs" Link="SharedSadConsole\SadConsoleViewModels.cs" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
+    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
+    <!-- Browser spike: source-build SadConsole.Host.MonoGame with KNI in the temp clone referenced above. -->
+    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" />
+    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
+    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.2" />
+  </ItemGroup>
+
+</Project>
