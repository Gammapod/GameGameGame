diff --git a/tools/build-html5-itch.ps1 b/tools/build-html5-itch.ps1
new file mode 100644
index 0000000..f3d60d9
--- /dev/null
+++ b/tools/build-html5-itch.ps1
@@ -0,0 +1,170 @@
+<#
+.SYNOPSIS
+    Builds and packages the SadConsole browser project for itch.io deployment.
+
+.DESCRIPTION
+    Publishes the GameGameGame.SadConsole.Browser project as a static Blazor WASM
+    deployment, then zips the output into an itch.io-compatible ZIP file.
+
+    itch.io requires:
+    - index.html at the ZIP root
+    - All assets (css/, _framework/, _content/) at the ZIP root
+    - No Brotli/gzip compression (BlazorEnableCompression=false)
+
+.PARAMETER Configuration
+    Build configuration. Default: Release.
+    Use Debug for faster iteration; Release for final uploads.
+
+.PARAMETER SkipPublish
+    Skip the dotnet publish step if the output directory already has a fresh build.
+
+.PARAMETER SkipZip
+    Skip the zip creation step.
+
+.PARAMETER ServeLocal
+    After building, start a local HTTP server to test the artifact.
+
+.EXAMPLE
+    .\tools\build-html5-itch.ps1
+    .\tools\build-html5-itch.ps1 -Configuration Debug
+    .\tools\build-html5-itch.ps1 -ServeLocal
+    .\tools\build-html5-itch.ps1 -SkipPublish  # Just re-zip an existing build
+#>
+param(
+    [ValidateSet("Debug", "Release")]
+    [string]$Configuration = "Release",
+    [switch]$SkipPublish,
+    [switch]$SkipZip,
+    [switch]$ServeLocal
+)
+
+$ErrorActionPreference = "Stop"
+$repoRoot = Split-Path $PSScriptRoot -Parent
+$browserProject = Join-Path $repoRoot "src\GameGameGame.SadConsole.Browser\GameGameGame.SadConsole.Browser.csproj"
+$publishDir = Join-Path $repoRoot "artifacts\html5-itch-publish"
+$zipPath = Join-Path $repoRoot "artifacts\GameGameGame-html5-itch.zip"
+
+# --- Sanity checks ---
+if (-not (Test-Path $browserProject)) {
+    Write-Error "Browser project not found at $browserProject"
+    exit 1
+}
+
+if (-not (Test-Path (Join-Path $repoRoot "artifacts"))) {
+    New-Item -ItemType Directory -Path (Join-Path $repoRoot "artifacts") | Out-Null
+}
+
+# --- Publish ---
+if (-not $SkipPublish) {
+    Write-Host "Publishing $Configuration Blazor WASM (compression disabled)..." -ForegroundColor Cyan
+
+    if (Test-Path $publishDir) {
+        Remove-Item -Recurse -Force $publishDir
+    }
+
+    dotnet publish $browserProject `
+        -c $Configuration `
+        -o $publishDir `
+        --nologo
+
+    if ($LASTEXITCODE -ne 0) {
+        Write-Error "dotnet publish failed with exit code $LASTEXITCODE"
+        exit $LASTEXITCODE
+    }
+
+    # Verify the key files exist in wwwroot
+    $wwwroot = Join-Path $publishDir "wwwroot"
+    $requiredFiles = @("index.html", "_framework\blazor.webassembly.js", "_framework\blazor.boot.json")
+    foreach ($f in $requiredFiles) {
+        $fullPath = Join-Path $wwwroot $f
+        if (-not (Test-Path $fullPath)) {
+            Write-Error "Required file missing after publish: $f"
+            exit 1
+        }
+    }
+
+    # Strip .br and .gz compression artifacts from _framework.
+    # itch.io's CDN does not serve Content-Encoding headers, so the Blazor loader
+    # fails when trying to decompress .br/.gz files. Removing them forces the
+    # loader to fetch the uncompressed .wasm files instead.
+    $frameworkDir = Join-Path $wwwroot "_framework"
+    $brFiles = Get-ChildItem $frameworkDir -Filter "*.br" -ErrorAction SilentlyContinue
+    $gzFiles = Get-ChildItem $frameworkDir -Filter "*.gz" -ErrorAction SilentlyContinue
+    $totalRemoved = 0
+    if ($brFiles) { $brFiles | Remove-Item -Force; $totalRemoved += $brFiles.Count }
+    if ($gzFiles) { $gzFiles | Remove-Item -Force; $totalRemoved += $gzFiles.Count }
+    if ($totalRemoved -gt 0) {
+        Write-Host "Removed $totalRemoved .br/.gz compression artifacts from _framework." -ForegroundColor Yellow
+    }
+
+    # Verify the uncompressed wasm files exist
+    $wasmFiles = Get-ChildItem $frameworkDir -Filter "*.wasm" -ErrorAction SilentlyContinue
+    if (-not $wasmFiles) {
+        Write-Error "No .wasm files found in _framework after stripping compression. Something is wrong."
+        exit 1
+    }
+    Write-Host "Kept $($wasmFiles.Count) uncompressed .wasm files in _framework." -ForegroundColor Green
+
+    Write-Host "Published to $wwwroot" -ForegroundColor Green
+} else {
+    $wwwroot = Join-Path $publishDir "wwwroot"
+    if (-not (Test-Path $wwwroot)) {
+        Write-Error "wwwroot not found at $wwwroot. Run without -SkipPublish first."
+        exit 1
+    }
+    Write-Host "Skipping publish, using existing $wwwroot" -ForegroundColor Yellow
+}
+
+# --- Zip ---
+if (-not $SkipZip) {
+    Write-Host "Creating itch.io ZIP..." -ForegroundColor Cyan
+
+    if (Test-Path $zipPath) {
+        Remove-Item -Force $zipPath
+    }
+
+    # Use .NET's ZipFile API to create a zip that preserves directory structure
+    # and excludes .br/.gz compression artifacts.
+    Add-Type -AssemblyName System.IO.Compression
+    Add-Type -AssemblyName System.IO.Compression.FileSystem
+    $zip = [IO.Compression.ZipFile]::Open($zipPath, 'Create')
+    try {
+        $allFiles = Get-ChildItem $wwwroot -Recurse -File |
+            Where-Object { $_.Extension -notin @(".br", ".gz") }
+        foreach ($file in $allFiles) {
+            # Compute the relative path from wwwroot (e.g., "css\app.css" -> "css/app.css")
+            $relativePath = $file.FullName.Substring($wwwroot.Length + 1).Replace('\', '/')
+            $entry = $zip.CreateEntry($relativePath, 'NoCompression')
+            $entryStream = $entry.Open()
+            $fileStream = [System.IO.File]::OpenRead($file.FullName)
+            try {
+                $fileStream.CopyTo($entryStream)
+            } finally {
+                $fileStream.Close()
+                $entryStream.Close()
+            }
+        }
+    } finally {
+        $zip.Dispose()
+    }
+
+    $zipSize = (Get-Item $zipPath).Length
+    $zipSizeMB = [math]::Round($zipSize / 1MB, 1)
+    Write-Host "Created $zipPath ($zipSizeMB MB)" -ForegroundColor Green
+}
+
+# --- Serve locally ---
+if ($ServeLocal) {
+    Write-Host "`nStarting local HTTP server on http://localhost:8080 ..." -ForegroundColor Cyan
+    Write-Host "Open http://localhost:8080 to test the build." -ForegroundColor Cyan
+    Write-Host "Press Ctrl+C to stop.`n" -ForegroundColor Yellow
+
+    Push-Location $wwwroot
+    try {
+        python -m http.server 8080
+    } finally {
+        Pop-Location
+    }
+}
+
+Write-Host "`nDone. Upload $zipPath to itch.io." -ForegroundColor Green

