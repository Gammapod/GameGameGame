diff --git a/src/GameGameGame.Content/PlayableScenarioLauncher.cs b/src/GameGameGame.Content/PlayableScenarioLauncher.cs
index fec3ec5..6f83051 100644
--- a/src/GameGameGame.Content/PlayableScenarioLauncher.cs
+++ b/src/GameGameGame.Content/PlayableScenarioLauncher.cs
@@ -1,3 +1,4 @@
+using System.Reflection;
 using GameGameGame.Core;
 
 namespace GameGameGame.Content;
@@ -45,6 +46,36 @@ public static class PlayableScenarioLauncher
     public static PlayableScenarioSession CreateFromCatalogEntry(ScenarioCatalogEntry entry) =>
         CreateFromFile(entry.ContentPath, entry.ScenarioId);
 
+    /// <summary>
+    /// Creates a session from a catalog entry, loading content from an embedded assembly resource
+    /// when the content path doesn't exist as a file on disk. Supports both desktop (file) and
+    /// browser (embedded resource) deployment.
+    /// </summary>
+    public static PlayableScenarioSession CreateFromCatalogEntry(
+        ScenarioCatalogEntry entry,
+        Assembly contentAssembly)
+    {
+        // Try file first (desktop), then embedded resource (browser)
+        if (File.Exists(entry.ContentPath))
+        {
+            return CreateFromFile(entry.ContentPath, entry.ScenarioId);
+        }
+
+        return CreateFromEmbeddedResource(contentAssembly, entry.ContentPath, entry.ScenarioId);
+    }
+
+    public static PlayableScenarioSession CreateFromEmbeddedResource(
+        Assembly contentAssembly,
+        string resourceName,
+        string scenarioId)
+    {
+        using var stream = contentAssembly.GetManifestResourceStream(resourceName)
+            ?? throw new InvalidOperationException($"Embedded resource {resourceName} was not found in assembly {contentAssembly.GetName().Name}.");
+        using var reader = new StreamReader(stream);
+        var document = EditableContentDocument.LoadYaml(reader.ReadToEnd());
+        return CreateFromDocument(document, scenarioId);
+    }
+
     public static PlayableScenarioSession CreateFromDocument(EditableContentDocument document, string scenarioId) =>
         CreateFromMaterialization(ScenarioMaterializer.Materialize(document, scenarioId));
 
diff --git a/src/GameGameGame.Content/ScenarioCatalog.cs b/src/GameGameGame.Content/ScenarioCatalog.cs
index 1e5fd30..7e88d6a 100644
--- a/src/GameGameGame.Content/ScenarioCatalog.cs
+++ b/src/GameGameGame.Content/ScenarioCatalog.cs
@@ -1,3 +1,4 @@
+using System.Reflection;
 using YamlDotNet.Serialization;
 using YamlDotNet.Serialization.NamingConventions;
 
@@ -13,11 +14,102 @@ public static class ScenarioCatalog
 {
     public const string ManifestFileName = "Manifest.yaml";
     private static readonly string RepositoryDefaultDiscoveryFolder = Path.Combine("src", "GameGameGame.Content", "Beta");
+    public const string EmbeddedResourceNamePrefix = "GameGameGame.Content.Beta.";
 
     public static string DefaultDiscoveryFolder => ResolveDefaultDiscoveryFolder();
 
     public static string DefaultManifestPath => Path.Combine(DefaultDiscoveryFolder, ManifestFileName);
 
+    /// <summary>
+    /// Builds a scenario catalog from embedded Beta YAML resources in the given assembly.
+    /// Used for browser deployment where filesystem access is unavailable.
+    /// Scans all embedded resources matching the Beta prefix, loads each YAML file as an
+    /// EditableContentDocument, and extracts scenarios from its Scenarios dictionary.
+    /// </summary>
+    public static ScenarioCatalogResult DiscoverEmbeddedCatalog(Assembly contentAssembly)
+    {
+        var entries = new List<ScenarioCatalogEntry>();
+        var diagnostics = new List<string>();
+
+        var resourceNames = contentAssembly.GetManifestResourceNames()
+            .Where(name => name.StartsWith(EmbeddedResourceNamePrefix, StringComparison.OrdinalIgnoreCase)
+                           && name != $"{EmbeddedResourceNamePrefix}Manifest.yaml"
+                           && (name.EndsWith(".yaml", StringComparison.OrdinalIgnoreCase)
+                               || name.EndsWith(".yml", StringComparison.OrdinalIgnoreCase)))
+            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
+            .ToList();
+
+        if (resourceNames.Count == 0)
+        {
+            return new ScenarioCatalogResult([], ["No embedded Beta YAML resources found in assembly."]);
+        }
+
+        foreach (var resourceName in resourceNames)
+        {
+            try
+            {
+                using var stream = contentAssembly.GetManifestResourceStream(resourceName);
+                if (stream is null)
+                {
+                    diagnostics.Add($"Could not open embedded resource: {resourceName}");
+                    continue;
+                }
+
+                using var reader = new StreamReader(stream);
+                var yaml = reader.ReadToEnd();
+                var document = EditableContentDocument.LoadYaml(yaml);
+
+                if (document.Scenarios.Count == 0)
+                {
+                    // Skip YAML files that don't define scenarios (e.g. calibration files)
+                    continue;
+                }
+
+                foreach (var (scenarioId, scenarioDto) in document.Scenarios)
+                {
+                    var name = string.IsNullOrWhiteSpace(scenarioDto.Name) ? scenarioId : scenarioDto.Name!;
+                    var description = $"Embedded resource: {resourceName}";
+                    entries.Add(new ScenarioCatalogEntry(resourceName, scenarioId, name, description));
+                }
+            }
+            catch (Exception ex)
+            {
+                diagnostics.Add($"Error loading embedded resource {resourceName}: {ex.Message}");
+            }
+        }
+
+        return new ScenarioCatalogResult(
+            entries.OrderBy(entry => entry.ScenarioId, StringComparer.Ordinal).ToList(),
+            diagnostics);
+    }
+
+    /// <summary>
+    /// Converts a Beta content file path to the corresponding embedded resource name.
+    /// Returns null if the path doesn't match the expected Beta content pattern.
+    /// </summary>
+    public static string? ConvertContentPathToEmbeddedResourceName(string contentPath)
+    {
+        var normalized = contentPath.Replace('\\', '/');
+
+        // Look for the Beta/ segment in the path
+        const string betaMarker = "Beta/";
+        var betaIndex = normalized.IndexOf(betaMarker, StringComparison.OrdinalIgnoreCase);
+        if (betaIndex < 0)
+        {
+            return null;
+        }
+
+        var relativePath = normalized[(betaIndex + betaMarker.Length)..];
+        if (!relativePath.EndsWith(".yaml", StringComparison.OrdinalIgnoreCase))
+        {
+            return null;
+        }
+
+        // Convert path separators to dots and strip .yaml extension
+        var resourceSuffix = relativePath.Replace('/', '.').Replace(".yaml", "");
+        return $"{EmbeddedResourceNamePrefix}{resourceSuffix}";
+    }
+
     public static ScenarioCatalogResult BuildFromDocument(string contentPath, EditableContentDocument document)
     {
         var entries = document.Scenarios
