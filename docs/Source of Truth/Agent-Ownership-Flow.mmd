flowchart TD
%% Intended to show the edges between agent workflows, does not define the full responsibilities within an agent's ownership.
  subgraph core["core-owner"]
    feature_start(("New Feature Needed"))
    planning?{"Already planned?"}
    simulation_work[["Implement core simulation"]]
    %%  Including TDD workflow and Editor parity
    frontend?{"New visuals needed?"}
    gameplay?{"Needs authored content/scenario coverage?"}
    spike_or_plan[["Planning Spike"]]
    feature_end((("New Feature Made")))
  end
  feature_start --> planning?
  planning? -->|yes| simulation_work
  planning? -->|no| spike_or_plan
  spike_or_plan --> simulation_work
  simulation_work --> gameplay?
  gameplay? -->|yes| scenario_start
  gameplay? -->|no| frontend?
  frontend? -->|yes| visuals_start
  frontend? -->|no| feature_end

  subgraph content["content-editor"]
    scenario_start(("New Scenario Needed"))
    create_scenario[["Create scenario"]]
    %% Including templates, presentation, action plans, validation, etc
    capability_gap?{"Capability Gap?"}
    scenario_end((("New Scenario Made")))
  end
  scenario_start --> capability_gap?
  capability_gap? -->|"yes"| feature_start
  capability_gap? -->|"no"| create_scenario
  create_scenario --> scenario_end

  subgraph frontend["frontend-owner"]
    visuals_start(("New Visuals Needed"))
    component_edit[["Create/change component(s)"]]
    contract?{"Clear simulation model exposed?"}
    visuals_end((("New Visuals Made")))
  end
  visuals_start --> contract?
  contract? -->|yes| component_edit
  contract? -->|no| feature_start
  component_edit --> visuals_end
