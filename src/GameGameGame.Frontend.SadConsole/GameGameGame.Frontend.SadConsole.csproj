<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameGameGame.Core\GameGameGame.Core.csproj" />
    <ProjectReference Include="..\GameGameGame.Content\GameGameGame.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SadConsole.Host.MonoGame" Version="10.10.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GameGameGame.Frontend.SadConsole</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameGameGame.Frontend.SadConsole.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\Candii.font">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>assets\Candii.font</TargetPath>
    </Content>
    <Content Include="..\..\assets\Candii.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>assets\Candii.png</TargetPath>
    </Content>
    <Content Include="..\..\assets\Candii.tileset.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>assets\Candii.tileset.json</TargetPath>
    </Content>
  </ItemGroup>

</Project>
